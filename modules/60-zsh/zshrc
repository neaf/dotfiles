ulimit -n 65536 2>/dev/null

eval "$(/opt/homebrew/bin/brew shellenv)"

# GNU tools ahead of the BSD ones. Install lives in modules/60-zsh/setup.sh.
for p in coreutils findutils gnu-sed grep; do
  path=("$HOMEBREW_PREFIX/opt/$p/libexec/gnubin" $path)
done
path=("$HOME/.local/bin" $path)

# --- completion ---
autoload -Uz compinit && compinit
setopt MENU_COMPLETE
unsetopt LIST_BEEP
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:*:git-checkout:*' verbose false

# --- zoxide (smarter cd, remembers frecent dirs) ---
eval "$(zoxide init zsh)"
alias cd="z"
alias j="z"

# --- fzf (fuzzy history / file / cd search: Ctrl-R, Ctrl-T, Alt-C) ---
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git"
bindkey '^G' fzf-cd-widget   # Alt-C -> ć on this keyboard, so use Ctrl-G instead

# fzf-tab replaces the completion menu. Must load after compinit and before syntax highlighting.
source "$HOMEBREW_PREFIX/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"

# --- git aliases ---
alias gs="git status"
alias gst="git status"
alias ga="git add"
alias gaa="git add -A"
alias gc="git commit"
alias gca="git commit --amend"
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gpl="git pull"
alias gu="git pull --rebase"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gb="git branch"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate -20"

# --- serve current directory over http ---
alias serve="python3 -m http.server"

# Machine-specific and private config (work env files, tokens). Not in this repo.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# SDKMAN must stay near the end of the file.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# Syntax highlighting wraps widgets, so it loads last.
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
